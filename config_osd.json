{
  "format": "0.0.1",
  "assets_dir": "/usr/share/pixelpilot/",
  "widgets": [
    {
      "name": "drone_topleft",
      "type": "BoxWidgetContainer",
      "x": 0,
      "y": 0,
      "width": 300,
      "height": 100,
      "color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "alpha": 0.4
      },
      "facts": [],
      "widgets": [
        {
          "name": "Armed",
          "type": "TplTextWidget",
          "x": 10,
          "y": 25,
          "template": "ARM: %s",
          "facts": [
            {
              "name": "mavlink.heartbeet.base_mode.armed"
            }
          ]
        },
        {
          "name": "Throttle",
          "type": "TplTextWidget",
          "x": 10,
          "y": 50,
          "template": "THR: %i%%",
          "facts": [
            {
              "name": "mavlink.vfr_hud.throttle"
            }
          ]
        },
        {
          "name": "Roll",
          "type": "TplTextWidget",
          "x": 10,
          "y": 75,
          "template": "R:%+.1f  P:%+.1f  Y:%.0f",
          "facts": [
            {
              "name": "mavlink.attitude.roll",
              "convert": "deg(x)"
            },
            {
              "name": "mavlink.attitude.pitch",
              "convert": "deg(x)"
            },
            {
              "name": "mavlink.attitude.yaw",
              "convert": "norm(deg(x), 360)"
            }
          ]
        }
      ]
    },
    {
      "name": "Compass",
      "type": "CompassWidget",
      "x": -185,
      "y": -185,
      "radius": 90,
      "mode": "north_up",
      "icon": "drone",
      "icon_color":  { "r": 0.9, "g": 0.15, "b": 0.15 },
      "show_home": true,
      "home_color":  { "r": 0.0, "g": 0.85, "b": 0.2 },
      "show_wind": true,
      "wind_color":  { "r": 0.2, "g": 0.75, "b": 1.0 },
      "bg_alpha": 0.4,
      "facts": [
        { "name": "mavlink.vfr_hud.heading" },
        { "name": "mavlink.home.bearing_relative" },
        { "name": "mavlink.wind.direction" },
        { "name": "mavlink.wind.speed" },
        { "name": "mavlink.home.distance" }
      ]
    },
    {
      "name": "heading_container",
      "type": "BoxWidgetContainer",
      "x": 0,
      "center_x": true,
      "y": 30,
      "width": 800,
      "height": 60,
      "color": { "r": 0.0, "g": 0.0, "b": 0.0, "alpha": 0.4 },
      "facts": [],
      "widgets": [
        {
          "name": "Heading",
          "type": "HeadingTapeWidget",
          "x": 0,
          "y": 0,
          "width": 800,
          "height": 60,
          "range": 360,
          "label_position": "top",
          "show_degrees": true,
          "degree_interval": 30,
          "tick_cardinal_h": 35,
          "tick_intercardinal_h": 22,
          "tick_medium_h": 12,
          "tick_small_h": 6,
          "center_color": { "r": 1.0, "g": 0.85, "b": 0.0 },
          "show_home": true,
          "home_color": { "r": 0.0, "g": 0.85, "b": 0.2 },
          "facts": [
            { "name": "mavlink.vfr_hud.heading" },
            { "name": "mavlink.home.bearing_relative" },
            { "name": "mavlink.home.distance" }
          ]
        }
      ]
    },
    {
      "name": "ArtificialHorizon",
      "type": "ArtificialHorizonWidget",
      "x": 760,
      "y": 120,
      "width": 400,
      "height": 250,
      "camera_tilt": 0,
      "pitch_range": 30,
      "ladder_interval": 10,
      "show_roll_arc": true,
      "bg_alpha": 0.1,
      "sky_color":    { "r": 0.10, "g": 0.28, "b": 0.58 },
      "ground_color": { "r": 0.32, "g": 0.18, "b": 0.04 },
      "facts": [
        { "name": "mavlink.attitude.roll" },
        { "name": "mavlink.attitude.pitch" }
      ]
    },
    {
      "name": "SpeedTape",
      "type": "VerticalTapeWidget",
      "x": 300,
      "y": 120,
      "width": 80,
      "height": 250,
      "range": 15,
      "tick_interval": 5,
      "unit": "m/s",
      "label_side": "right",
      "format": "%.0f",
      "facts": [
        { "name": "mavlink.vfr_hud.airspeed" }
      ]
    },
    {
      "name": "AltitudeTape",
      "type": "VerticalTapeWidget",
      "x": 1160,
      "y": 120,
      "width": 80,
      "height": 250,
      "range": 15,
      "tick_interval": 5,
      "unit": "m",
      "label_side": "left",
      "format": "%.0f",
      "facts": [
        { "name": "mavlink.vfr_hud.alt" }
      ]
    },
